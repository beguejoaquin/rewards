// use prisma-8

enum user_type {
  @@type("pg/text@1")
  admin
  owner
}

enum VoucherState {
  @@type("pg/text@1")
  Valid    = "valid"
  Consumed = "consumed"
  Expired  = "expired" // vencido por fecha
  Revoked  = "revoked" // anulado manualmente por el negocio
}

model User {
  id          Uuid      @id @onCreate(uuid())
  email       String    @unique
  name        String
  lastName    String
  createdAt   DateTime  @default(now())
  type        user_type
  business    Business[]
  @@map("user")
}

model Business {
  id            Uuid      @id @onCreate(uuid())
  ownerId       Uuid
  name          String
  email         String    
  createdAt     DateTime  @default(now()) @onCreate(now())

  customers Customer[]
  services  Service[]
  rewards   Reward[]
  vouchers  Voucher[]
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@map("business")
}

model Customer {
  id         Uuid      @id @onCreate(uuid())
  name       String
  email      String
  points     Int      @default(0)
  businessId Uuid
  createdAt  DateTime @default(now()) @onCreate(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vouchers Voucher[]

  // An email can exists across multiple bussiness, but i cant be repeated inside
  // the same business.
  @@unique([businessId, email])
  @@map("customer")
}

model Service {
  id         Uuid      @id @onCreate(uuid())
  name       String
  points     Int // puntos que otorga al consumirlo
  businessId Uuid
  createdAt  DateTime @default(now()) @onCreate(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("service")
}

model Reward {
  id             Uuid      @id @onCreate(uuid())
  name           String
  points         Int  
  expirationDays Int 
  businessId     Uuid
  createdAt      DateTime @default(now()) @onCreate(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vouchers Voucher[]

  @@index([businessId])
  @@map("reward")
}

model Voucher {
  id             Uuid      @id @onCreate(uuid())
  rewardId       Uuid
  customerId     Uuid
  businessId     Uuid
  expirationDate DateTime
  state          VoucherState @default(Valid)
  createdAt      DateTime     @default(now()) @onCreate(now())

  // Restrict: a reward that has emmited vouchers cant be deleted.
  reward   Reward   @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, state])
  @@index([customerId])
  // For the job that marks expirations and sends reminders.
  @@index([state, expirationDate])
  @@map("voucher")
}
